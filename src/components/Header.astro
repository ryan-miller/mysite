---
import { profile, nav } from '../data/profile';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${profile.name} — home`}>
      <span class="mark">{profile.initials}</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  const menuBtn = document.getElementById('menu-toggle');
  const navEl = document.getElementById('site-nav');
  menuBtn?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 700;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--ink);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .actions {
    display: flex;
    gap: 0.4rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--accent);
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 820px) {
    .menu-btn {
      display: grid;
    }
    .nav {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .nav.open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      padding: 0.75rem 1.25rem 1.25rem;
    }
    .nav a {
      font-size: 1.05rem;
      padding: 0.7rem 0.9rem;
    }
  }
</style>
