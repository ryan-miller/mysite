---
// Layered landscape: sky, sun, ridgelines, road, and a gently rocking Airstream.
import Airstream from './Airstream.astro';
---

<div class="scene" aria-hidden="true">
  <svg class="land" viewBox="0 0 600 420" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="sky-top" />
        <stop offset="1" class="sky-bottom" />
      </linearGradient>
    </defs>
    <rect width="600" height="420" fill="url(#sky)" />
    <circle class="sun" cx="430" cy="150" r="58" />
    <g class="birds" fill="none" stroke-width="2" stroke-linecap="round">
      <path d="M150 90 q8 -8 16 0 q8 -8 16 0" />
      <path d="M195 70 q6 -6 12 0 q6 -6 12 0" />
    </g>
    <path class="ridge r1" d="M0 250 L70 190 L120 225 L200 150 L270 215 L340 170 L410 230 L480 180 L560 220 L600 200 L600 420 L0 420 Z" />
    <path class="ridge r2" d="M0 290 L90 245 L160 280 L250 230 L330 275 L420 240 L520 285 L600 255 L600 420 L0 420 Z" />
    <path class="ridge r3" d="M0 330 C120 300 220 320 300 310 C390 298 480 318 600 300 L600 420 L0 420 Z" />
    <path class="road" d="M0 372 C150 358 420 360 600 352 L600 420 L0 420 Z" />
    <path class="lane" d="M0 392 C150 380 420 382 600 374" fill="none" stroke-width="3" stroke-dasharray="18 16" />
  </svg>
  <div class="rig">
    <Airstream width={260} />
  </div>
</div>

<style>
  .scene {
    position: relative;
    aspect-ratio: 600 / 420;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .land {
    width: 100%;
    height: 100%;
  }
  .sky-top {
    stop-color: #f7c59f;
  }
  .sky-bottom {
    stop-color: #fbe7d3;
  }
  .sun {
    fill: #f08a4b;
    animation: rise 9s ease-in-out infinite alternate;
  }
  .birds {
    stroke: #6b4b3e;
    opacity: 0.6;
  }
  .r1 {
    fill: #c98a6b;
  }
  .r2 {
    fill: #a2614b;
  }
  .r3 {
    fill: #6e4438;
  }
  .road {
    fill: #3b3230;
  }
  .lane {
    stroke: #e9c46a;
    animation: drive 1.6s linear infinite;
  }
  :global([data-theme='dark']) .sky-top {
    stop-color: #1d2b4a;
  }
  :global([data-theme='dark']) .sky-bottom {
    stop-color: #5b4a6e;
  }
  :global([data-theme='dark']) .sun {
    fill: #f3e7c9;
  }
  :global([data-theme='dark']) .birds {
    stroke: #cdbfdc;
  }
  :global([data-theme='dark']) .r1 {
    fill: #3d3a5c;
  }
  :global([data-theme='dark']) .r2 {
    fill: #2c2a45;
  }
  :global([data-theme='dark']) .r3 {
    fill: #1e1d31;
  }
  :global([data-theme='dark']) .road {
    fill: #141320;
  }
  .rig {
    position: absolute;
    left: 36%;
    bottom: 9%;
    width: 46%;
    transform: translateX(-50%);
    animation: bob 2.4s ease-in-out infinite;
    filter: drop-shadow(0 10px 8px rgb(0 0 0 / 0.25));
  }
  .rig :global(svg) {
    width: 100%;
    height: auto;
  }
  @keyframes drive {
    to {
      stroke-dashoffset: -34;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, -2px);
    }
  }
  @keyframes rise {
    from {
      transform: translateY(6px);
    }
    to {
      transform: translateY(-6px);
    }
  }
</style>
