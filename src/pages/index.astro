---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import { profile } from '../data/profile';
import { books } from '../data/books';
import { trips } from '../data/travels';
import { coaching } from '../data/coaching';

const nowReading = books.find((b) => b.shelf === 'reading');
const nextTrip = trips.find((t) => t.upcoming && !t.route.includes('TODO'));

const portals = [
  {
    href: '/resume/',
    kicker: 'Work',
    title: 'Resume',
    body: 'Career, experience, and the skills behind the work, in profile form.',
    icon: 'M4 7h16v12H4zM9 7V5h6v2M4 12h16',
    tone: 'sky',
  },
  {
    href: '/coaching/',
    kicker: 'Swim · Bike · Run',
    title: 'Multisport Coaching',
    body: 'Structured, personal coaching for triathletes and endurance athletes with real lives.',
    icon: 'M13 4a2 2 0 1 0 0 .01M7 21l3-6 3 2v4M10 15l2-5 4 3h3M6 12l3-3h3',
    tone: 'accent',
  },
  {
    href: '/books/',
    kicker: 'Reading',
    title: 'Books',
    body: 'What I’m reading, what stuck with me, and what’s next on the nightstand.',
    icon: 'M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4zM20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z',
    tone: 'pine',
  },
  {
    href: '/travels/',
    kicker: 'On the road',
    title: 'Airstream Travels',
    body: 'Trip logs, favorite campsites, and lessons from life behind a silver bullet.',
    icon: 'M3 16c0-5 3-9 9-9h3c4 0 6 4 6 9H3zM8 16v2M17 16v2M7 11h3',
    tone: 'gold',
  },
];
---

<Base>
  <!-- HERO -->
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow">Hello, I'm</span>
      <h1>
        {profile.name}<span class="dot">.</span>
      </h1>
      <p class="rotator" aria-live="polite">
        I'm a <span class="role" id="role">{profile.roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="lede">{profile.tagline}</p>
      <div class="cta">
        <a class="btn btn-primary" href="/resume/">
          View my resume
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn btn-ghost" href="/coaching/">Train with me</a>
      </div>
    </div>
    <div class="hero-art">
      <HeroScene />
      <aside class="now card" aria-label="What I'm up to now">
        <p class="now-title"><span class="pulse"></span> Right now</p>
        <dl>
          {
            nowReading && (
              <div>
                <dt>Reading</dt>
                <dd>
                  <a href="/books/">{nowReading.title}</a>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Coaching</dt>
            <dd><a href="/coaching/">{coaching.sports.slice(0, 2).join(' & ')}</a></dd>
          </div>
          {
            nextTrip && (
              <div>
                <dt>Next stop</dt>
                <dd>
                  <a href="/travels/">{nextTrip.route.split('→').pop()?.trim()}</a>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <span>
            Swim <i>✦</i> Bike <i>✦</i> Run <i>✦</i> Read <i>✦</i> Build <i>✦</i> Lead <i>✦</i> Tow <i>✦</i> Explore <i>✦</i> Repeat <i>✦</i>&nbsp;
          </span>
        ))
      }
    </div>
  </div>

  <!-- PORTALS -->
  <section class="section container">
    <div class="section-head reveal">
      <span class="eyebrow">Explore</span>
      <h2>A few things I care about</h2>
      <p class="lede">Different trails, same approach: be curious, put in the work consistently, and enjoy the view along the way.</p>
    </div>
    <div class="portals">
      {
        portals.map((p, i) => (
          <a href={p.href} class={`portal card reveal tone-${p.tone}`} style={`transition-delay:${i * 80}ms`}>
            <span class="portal-icon">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </span>
            <span class="portal-kicker">{p.kicker}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <span class="portal-go">
              Explore
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section about-band">
    <div class="container about-grid">
      <div class="monogram reveal" aria-hidden="true">
        <span>{profile.initials}</span>
      </div>
      <div class="reveal">
        <span class="eyebrow">About me</span>
        <h2>Equal parts spreadsheet and sunrise.</h2>
        <p class="lede">
          By day I solve problems with smart people. The rest of the time I'm coaching athletes toward their next
          finish line, working through a stack of books, or pointing the Airstream at a spot on the map I haven't seen yet.
        </p>
        <a class="btn btn-ghost" href="/about/">More about me</a>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="section container">
    <figure class="quote reveal">
      <blockquote>“Not all those who wander are lost, but a good training plan and a full propane tank sure help.”</blockquote>
      <figcaption>— With apologies to Tolkien</figcaption>
    </figure>
  </section>

  <!-- CONTACT -->
  <section class="container">
    <div class="contact card reveal">
      <div>
        <h2>Let's connect.</h2>
        <p class="lede">Working on something interesting, chasing a race goal, or want a book or campsite recommendation? Send me a note.</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>Say hello</a>
        <a class="btn btn-ghost" href={profile.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ roles: profile.roles }}>
  const el = document.getElementById('role');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    let i = 0;
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      while (true) {
        await sleep(2200);
        const word = roles[i];
        for (let n = word.length; n >= 0; n--) {
          el.textContent = word.slice(0, n);
          await sleep(35);
        }
        i = (i + 1) % roles.length;
        const next = roles[i];
        for (let n = 1; n <= next.length; n++) {
          el.textContent = next.slice(0, n);
          await sleep(65);
        }
      }
    })();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }
  .hero h1 {
    font-size: clamp(3.2rem, 8vw, 6.2rem);
    margin-bottom: 0.2em;
  }
  .dot {
    color: var(--accent);
  }
  .rotator {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    margin-bottom: 1.1rem;
    min-height: 1.5em;
  }
  .role {
    color: var(--accent);
    font-style: italic;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-art {
    position: relative;
  }
  .now {
    position: absolute;
    right: -1.5rem;
    bottom: -2rem;
    padding: 1rem 1.2rem;
    min-width: 230px;
    font-size: 0.9rem;
  }
  .now-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3fb950;
    box-shadow: 0 0 0 0 rgb(63 185 80 / 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgb(63 185 80 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(63 185 80 / 0);
    }
  }
  .now dl {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .now dl > div {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 0.5rem;
  }
  .now dt {
    color: var(--muted);
  }
  .now dd {
    margin: 0;
    font-weight: 600;
  }
  .now a {
    text-decoration: none;
  }

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: 1rem;
    margin-top: 2rem;
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 600;
    white-space: nowrap;
  }
  .track i {
    font-style: normal;
    color: var(--accent);
    margin-inline: 0.9rem;
    font-size: 0.7em;
    vertical-align: 0.15em;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .section-head {
    margin-bottom: 2.5rem;
  }
  .portals {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .portal {
    --tone: var(--accent);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .tone-sky {
    --tone: var(--sky);
  }
  .tone-pine {
    --tone: var(--pine);
  }
  .tone-gold {
    --tone: var(--gold);
  }
  .portal::after {
    content: '';
    position: absolute;
    inset: auto -40% -60% auto;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--tone) 22%, transparent), transparent 70%);
    transition: transform 0.4s ease;
  }
  .portal:hover {
    color: inherit;
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--tone) 55%, var(--line));
  }
  .portal:hover::after {
    transform: scale(1.4);
  }
  .portal-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--tone) 14%, transparent);
    color: var(--tone);
    margin-bottom: 1.4rem;
  }
  .portal-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--tone);
    margin-bottom: 0.4rem;
  }
  .portal p {
    color: var(--muted);
    font-size: 0.97rem;
    flex: 1;
  }
  .portal-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--tone);
  }
  .portal-go svg {
    transition: transform 0.2s ease;
  }
  .portal:hover .portal-go svg {
    transform: translateX(4px);
  }

  .about-band {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .monogram {
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 55%),
      radial-gradient(circle at 75% 80%, color-mix(in srgb, var(--pine) 60%, transparent), transparent 55%),
      var(--ink);
    box-shadow: var(--shadow);
  }
  .monogram span {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 700;
    color: var(--bg);
  }

  .quote {
    margin: 0;
    text-align: center;
  }
  .quote blockquote {
    margin: 0 auto 1rem;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
    font-style: italic;
  }
  .quote figcaption {
    color: var(--muted);
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 50%),
      var(--surface);
  }
  .contact h2 {
    margin-bottom: 0.3em;
  }
  .contact .lede {
    margin: 0;
  }
  .contact-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  @media (max-width: 1000px) {
    .portals {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .now {
      position: static;
      margin-top: 1rem;
    }
    .about-grid {
      grid-template-columns: 1fr;
    }
    .monogram {
      width: 180px;
    }
    .monogram span {
      font-size: 3.6rem;
    }
    .contact {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .portals {
      grid-template-columns: 1fr;
    }
  }
</style>
