---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={post.data.title} description={post.data.description}>
  <article class="container post">
    <a class="back" href="/blog/">← All posts</a>
    <header>
      <time datetime={post.data.date.toISOString()}>{date}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: 720px;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .back {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  header {
    margin: 1.5rem 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  time {
    font-size: 0.85rem;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin-top: 0.4rem;
  }
  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: 2em;
  }
  .prose :global(h3) {
    margin-top: 1.6em;
  }
  .prose :global(code) {
    font-size: 0.9em;
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 12px;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
  }
  .prose :global(img) {
    border-radius: 12px;
  }
</style>
